@model TaskItem
@{
    ViewData["Title"] = "Преглед на задача";
    var priorityClass = $"priority-{Model.Priority.ToString().ToLowerInvariant()}";
    var progress = Model.EstimatedMinutes == 0 ? 0 : Math.Min(100, Model.CompletedMinutes * 100d / Model.EstimatedMinutes);
}

<header class="page-header compact-header">
    <div><span class="eyebrow text-primary">Детайли</span><h1>@Model.Title</h1><p>@(Model.Description ?? "Няма добавено описание.")</p></div>
    <span class="priority-badge @priorityClass">@Html.DisplayFor(model => model.Priority) · @Model.PriorityScore/100</span>
</header>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <section class="content-card h-100">
            <h2 class="h4 mb-4">Информация</h2>
            <dl class="details-grid">
                <div><dt>@Html.DisplayNameFor(model => model.Category)</dt><dd>@Html.DisplayFor(model => model.Category)</dd></div>
                <div><dt>@Html.DisplayNameFor(model => model.Status)</dt><dd>@Html.DisplayFor(model => model.Status)</dd></div>
                <div><dt>@Html.DisplayNameFor(model => model.Deadline)</dt><dd>@Model.Deadline.ToString("dd.MM.yyyy HH:mm")</dd></div>
                <div><dt>@Html.DisplayNameFor(model => model.DeadlineCategory)</dt><dd>@Html.DisplayFor(model => model.DeadlineCategory)</dd></div>
                <div><dt>@Html.DisplayNameFor(model => model.UserImportance)</dt><dd>@Model.UserImportance / 5</dd></div>
            </dl>
            <h3 class="h5 mt-4">Напредък по време</h3>
            <div class="progress mt-3" role="progressbar" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar progress-bar-time" style="width: @progress%"></div></div>
            <small>@Model.CompletedMinutes от @Model.EstimatedMinutes минути</small>
        </section>
    </div>
    <div class="col-12 col-lg-4">
        <aside class="content-card h-100">
            <span class="eyebrow text-primary">Mock AI анализ</span>
            <h2 class="h5 mt-2">Защо този приоритет?</h2>
            <p class="mt-3 mb-4">@Model.PriorityReason</p>
            <div class="d-grid gap-2">
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Редактирай</a>
                <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Изтрий</a>
                <a class="btn btn-outline-secondary" asp-action="Index">Назад към списъка</a>
            </div>
        </aside>
    </div>
</div>

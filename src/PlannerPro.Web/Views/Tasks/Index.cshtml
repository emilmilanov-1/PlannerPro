@model TaskListViewModel
@{
    ViewData["Title"] = "Задачи";
}

<header class="page-header">
    <div><span class="eyebrow text-primary">Организация</span><h1>Моите задачи</h1><p>Създавай, филтрирай и следи всички свои задачи на едно място.</p></div>
    <a class="btn btn-primary" asp-action="Create">+ Нова задача</a>
</header>

<form method="get" class="content-card filter-panel mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-lg-4">
            <label asp-for="Search" class="form-label">Търсене</label>
            <input asp-for="Search" class="form-control" placeholder="Заглавие или описание" />
        </div>
        <div class="col-12 col-md-4 col-lg-2">
            <label asp-for="Status" class="form-label">Статус</label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<PlannerTaskStatus>()" class="form-select"><option value="">Всички</option></select>
        </div>
        <div class="col-12 col-md-4 col-lg-2">
            <label asp-for="Category" class="form-label">Категория</label>
            <select asp-for="Category" asp-items="Html.GetEnumSelectList<TaskCategory>()" class="form-select"><option value="">Всички</option></select>
        </div>
        <div class="col-12 col-md-4 col-lg-2">
            <label asp-for="Priority" class="form-label">Приоритет</label>
            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TaskPriority>()" class="form-select"><option value="">Всички</option></select>
        </div>
        <div class="col-12 col-lg-2 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit">Филтрирай</button>
            <a class="btn btn-outline-secondary" asp-action="Index" aria-label="Изчисти филтрите">×</a>
        </div>
    </div>
</form>

@if (Model.Tasks.Count == 0)
{
    <section class="content-card empty-state">
        <div class="empty-icon" aria-hidden="true">✓</div>
        <h2>Няма намерени задачи</h2>
        <p>Промени филтрите или създай нова задача.</p>
        <a class="btn btn-primary" asp-action="Create">Добави задача</a>
    </section>
}
else
{
    <section class="content-card table-card">
        <div class="table-responsive">
            <table class="table task-table align-middle mb-0">
                <thead><tr><th>Задача</th><th>Категория</th><th>Срок</th><th>Статус</th><th>Приоритет</th><th class="text-end">Действия</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Tasks)
                {
                    var isOverdue = item.Deadline < DateTime.Now && item.Status != PlannerTaskStatus.Completed;
                    var priorityClass = $"priority-{item.Priority.ToString().ToLowerInvariant()}";
                    <tr class="@(item.Status == PlannerTaskStatus.Completed ? "task-completed" : null)">
                        <td><a class="task-title" asp-action="Details" asp-route-id="@item.Id">@item.Title</a><small>@item.CompletedMinutes / @item.EstimatedMinutes мин.</small></td>
                        <td>@Html.DisplayFor(_ => item.Category)</td>
                        <td><span class="@(isOverdue ? "text-danger fw-semibold" : null)">@item.Deadline.ToString("dd.MM.yyyy HH:mm")</span><small class="@(isOverdue ? "text-danger" : null)">@Html.DisplayFor(_ => item.DeadlineCategory)</small></td>
                        <td><span class="status-badge">@Html.DisplayFor(_ => item.Status)</span></td>
                        <td><span class="priority-badge @priorityClass">@Html.DisplayFor(_ => item.Priority) · @item.PriorityScore</span></td>
                        <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Редакция</a> <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Преглед</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
